<html lang='en'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <title>{{subject}}</title>
    </head>
    <body
        style="margin: 0; padding: 0; background-color: #faf9f6; font-family: 'Baskerville', 'Georgia', 'Times New Roman', serif, -apple-system, BlinkMacSystemFont, sans-serif; color: #2c2a29; -webkit-font-smoothing: antialiased;"
    >
        <table
            role='presentation'
            width='100%'
            cellspacing='0'
            cellpadding='0'
            style='background-color: #faf9f6; padding: 60px 20px;'
        >
            <tr>
                <td align='center'>
                    <table
                        role='presentation'
                        width='100%'
                        cellspacing='0'
                        cellpadding='0'
                        style='max-width: 520px; background: #ffffff; border: 1px solid #e8e5e0; border-radius: 4px; padding: 48px 40px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);'
                    >

                        <!-- Subtle Brand Accent Line -->
                        <tr>
                            <td align='center' style='padding-bottom: 32px;'>
                                <div
                                    style='width: 36px; height: 1px; background-color: #a38f78;'
                                ></div>
                            </td>
                        </tr>

                        <!-- Header -->
                        <tr>
                            <td style='text-align: center; padding-bottom: 24px;'>
                                <h1
                                    style='margin: 0; font-size: 24px; font-weight: 400; color: #1a1818; letter-spacing: 0.5px; line-height: 1.3;'
                                >
                                    {{t 'greeting' username=username}}
                                </h1>
                            </td>
                        </tr>

                        <!-- Body Content -->
                        <tr>
                            <td
                                style='font-size: 15px; line-height: 1.8; color: #55514e; text-align: center; padding-bottom: 24px;'
                            >
                                <p style='margin: 0 0 24px 0;'>
                                    {{t paragraph1}}
                                </p>

                                <!-- Elegant CTA Button -->
                                <table
                                    role='presentation'
                                    cellspacing='0'
                                    cellpadding='0'
                                    style='margin: 32px auto;'
                                >
                                    <tr>
                                        <td
                                            align='center'
                                            style='border-radius: 2px; background-color: #1a1818;'
                                        >
                                            <a
                                                href='{{activationLink}}'
                                                target='_blank'
                                                style="font-size: 13px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 2px; border: 1px solid #1a1818; display: inline-block; font-weight: 500; letter-spacing: 1px; text-transform: uppercase;"
                                            >{{t button}}</a>
                                        </td>
                                    </tr>
                                </table>

                                <p
                                    style='margin: 24px 0 0 0; font-size: 13px; color: #8c857b; font-style: italic;'
                                >
                                    {{t footer_disclaimer}}
                                </p>
                            </td>
                        </tr>

                        <!-- Divider -->
                        <tr>
                            <td align='center' style='padding-bottom: 32px;'>
                                <div style='width: 100%; border-top: 1px dashed #e8e5e0;'></div>
                            </td>
                        </tr>

                        <!-- Sign-off -->
                        <tr>
                            <td
                                style='font-size: 14px; line-height: 1.6; color: #8c857b; text-align: center;'
                            >
                                <p style='margin: 0 0 4px 0; font-style: italic;'>
                                    Warm regards,
                                </p>
                                <p
                                    style='margin: 0; font-weight: 600; letter-spacing: 0.5px; color: #403d39;'
                                >
                                    Stay Sync Hotel
                                </p>
                            </td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td style='text-align: center; padding-top: 40px;'>
                                <p
                                    style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 11px; color: #b0a8a0; letter-spacing: 0.5px;"
                                >
                                    &copy; 2026 Stay Sync Hotel. All rights reserved.
                                </p>
                            </td>
                        </tr>

                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>