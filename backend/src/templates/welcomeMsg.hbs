<html lang='en'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <title>{{t 'subject' companyName=companyName}}</title>
    </head>
    <body
        style="margin: 0; padding: 0; background-color: #faf9f6; font-family: 'Baskerville', 'Georgia', 'Times New Roman', serif; color: #2c2a29; -webkit-font-smoothing: antialiased;"
    >
        <table
            role='presentation'
            width='100%'
            cellspacing='0'
            cellpadding='0'
            style='background-color: #faf9f6; padding: 60px 20px;'
        >
            <tr>
                <td align='center'>
                    <table
                        role='presentation'
                        width='100%'
                        cellspacing='0'
                        cellpadding='0'
                        style='max-width: 520px; background: #ffffff; border: 1px solid #e8e5e0; border-radius: 4px; padding: 48px 40px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);'
                    >

                        <!-- Subtle Brand Accent / Line -->
                        <tr>
                            <td align='center' style='padding-bottom: 32px;'>
                                <div
                                    style='width: 36px; height: 1px; background-color: #a38f78;'
                                ></div>
                            </td>
                        </tr>

                        <!-- Header -->
                        <tr>
                            <td style='text-align: center; padding-bottom: 24px;'>
                                <h1
                                    style='margin: 0; font-size: 26px; font-weight: 400; color: #1a1818; letter-spacing: 0.5px; line-height: 1.3;'
                                >
                                    {{t 'greeting' username=username}}
                                </h1>
                            </td>
                        </tr>

                        <!-- Body Content -->
                        <tr>
                            <td
                                style='font-size: 15px; line-height: 1.8; color: #55514e; text-align: center; padding-bottom: 32px;'
                            >
                                <p style='margin: 0 0 16px 0;'>
                                    {{t 'thankYou' companyName=companyName}}
                                </p>
                                <p style='margin: 0;'>
                                    {{t 'activeNotice'}}
                                </p>
                            </td>
                        </tr>

                        <!-- Divider -->
                        <tr>
                            <td align='center' style='padding-bottom: 32px;'>
                                <div style='width: 100%; border-top: 1px dashed #e8e5e0;'></div>
                            </td>
                        </tr>

                        <!-- Sign-off / Note -->
                        <tr>
                            <td
                                style='font-size: 14px; line-height: 1.6; color: #8c857b; text-align: center;'
                            >
                                <p style='margin: 0 0 4px 0; font-style: italic;'>
                                    {{t 'warmRegards'}}
                                </p>
                                <p
                                    style='margin: 0; font-weight: 600; letter-spacing: 0.5px; color: #403d39;'
                                >
                                    {{t 'team' companyName=companyName}}
                                </p>
                            </td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td style='text-align: center; padding-top: 40px;'>
                                <p
                                    style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 11px; color: #b0a8a0; letter-spacing: 0.5px;"
                                >
                                    {{t 'copyright' year=2026 companyName=companyName}}
                                </p>
                            </td>
                        </tr>

                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>